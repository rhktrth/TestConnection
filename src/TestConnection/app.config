<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="TestConnection.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>
  <userSettings>
    <TestConnection.Properties.Settings>
      <setting name="subnetmask" serializeAs="String"><value>255.255.255.0</value></setting>
      <setting name="defaultgateway" serializeAs="String"><value>0.0.0.0</value></setting>
      <setting name="repeatcount" serializeAs="String"><value>0</value></setting>
      <setting name="testinterval" serializeAs="String"><value>500</value></setting>
      <setting name="repeatInterval" serializeAs="String"><value>1000</value></setting>
      <setting name="timeout" serializeAs="String"><value>1000</value></setting>
      <setting name="resultupdateinterval" serializeAs="String"><value>500</value></setting>
      <setting name="logradio1" serializeAs="String"><value>True</value></setting>
      <setting name="logradio2" serializeAs="String"><value>False</value></setting>
      <setting name="logradio3" serializeAs="String"><value>False</value></setting>
      <setting name="logfilename" serializeAs="String"><value>.\tescon.log</value></setting>
      <setting name="sound" serializeAs="String"><value>False</value></setting>
      <setting name="selectedNicSettingId" serializeAs="String"><value /></setting>
    </TestConnection.Properties.Settings>
  </userSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>
</configuration>
